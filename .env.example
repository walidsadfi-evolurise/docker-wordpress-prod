# Copy to .env and fill in. Secrets live in ./secrets/, not here (scripts/init.sh generates them).
COMPOSE_PROJECT_NAME=wp
SITE_HOST=shop.example.com
ACME_EMAIL=admin@example.com

WORDPRESS_TAG=6-php8.3-fpm-alpine
DB_NAME=wordpress
DB_USER=wordpress
DB_PREFIX=wp_
REDIS_MAXMEMORY=256mb

# Backups (leave S3_BUCKET empty to keep backups local only)
BACKUP_CRON=0 3 * * *
BACKUP_KEEP_DAYS=14
S3_BUCKET=
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-3
